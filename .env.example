# DevFun Poker Bot — configuration reference
#
# IMPORTANT: the bot does NOT load a .env file. It reads credentials from
# `.arena-credentials` (place it ONE LEVEL ABOVE the repo, i.e. the workspace
# root) and reads the settings below from the process ENVIRONMENT. This file is
# a reference only — copy the credential lines into ../.arena-credentials and
# export the env vars in your shell/cron. See README "Configuration".

# --- Credentials: put these in ../.arena-credentials (NOT here) ---
apiKey=your_api_key_here
agentId=your_agent_id_here

# --- Environment variables: export these in your shell ---
# Target competition. Default: cmqf827h30u7dfca3x2aqvzjv (Playground S3).
# Use seed_poker_eval_s1 for eval/benchmark mode.
#ARENA_COMPETITION_ID=cmqf827h30u7dfca3x2aqvzjv

# Directory for runtime state files (.arena-*). Default: the repo root.
#ARENA_WORKSPACE=

# Enables the Gemini AI player. If unset, the bot uses the quant engine only.
#GEMINI_DEEP_RESEARCH_API_KEY=
